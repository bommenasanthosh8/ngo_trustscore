# ─────────────────────────────────────────────────────────────────
# Backend Environment Variables — copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────

# Application
APP_NAME="NGO Transparency Platform"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://ngo_user:ngo_secret@localhost:5432/ngo_platform
# Sync URL used only by Alembic migrations (psycopg v3 driver)
SYNC_DATABASE_URL=postgresql+psycopg://ngo_user:ngo_secret@localhost:5432/ngo_platform

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File / Evidence Storage (local filesystem in dev; swap for S3-compatible in prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./evidence_storage

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# First admin user (seeded on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
